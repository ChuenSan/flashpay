{
  "name": "flashpay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts/*.ts tests --no-warn-ignored",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test": "tsx --test tests/*.test.ts src/lib/__tests__/*.test.ts",
    "verify:api": "tsx scripts/verify-api.ts",
    "verify:browser": "tsx scripts/verify-browser.ts",
    "admin:hash": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "16.4.4",
    "prisma": "6.19.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
