# Independent expiry: does not need the database, application env or encryption key.
[Unit]
Description=Flashpay private backup retention cleanup
RequiresMountsFor=/var/backups/flashpay

[Service]
Type=oneshot
User=flashpay
Group=flashpay
WorkingDirectory=/opt/flashpay
UMask=0077
ExecStart=/opt/flashpay/scripts/project-tool python3 -B /opt/flashpay/scripts/backup.py prune --backup-dir /var/backups/flashpay
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/flashpay
StandardOutput=journal
StandardError=journal
